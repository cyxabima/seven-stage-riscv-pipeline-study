\begin{tikzpicture}[
    font=\small,
    >=Stealth,
    blk/.style={draw, rectangle, minimum width=1.0cm, minimum height=0.9cm, align=center, fill=white},
    preg/.style={draw, rectangle, minimum width=1.5cm, minimum height=1.05cm, align=center, fill=gray!12, font=\tiny, inner sep=2pt},
    mux/.style={draw, rectangle, minimum width=1.4cm, align=center, fill=white, font=\scriptsize, inner sep=1pt},
    fu/.style={draw, rectangle, minimum width=3.0cm, minimum height=1.0cm, align=center, fill=gray!25},
    arr/.style={->, semithick},
    ctrl/.style={->, semithick, dashed},
    lbl/.style={font=\scriptsize, fill=white, inner sep=1pt},
    pin/.style={font=\tiny, anchor=south east, inner sep=1pt}
]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% (a) INTEGER FORWARDING INTERFACE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\node[font=\bfseries] at (8.0, 13.35) {(a) Integer forwarding interface};

\node[preg] (idex) at (1.2, 9.6) {\textbf{\scriptsize ID/EX}\\Rs1, Rs2, Fs1, Fs2\\ReadData1\\ReadData2};
\node[mux, minimum height=1.4cm] (muxA) at (4.2, 10.5) {4:1\\MUX A};
\node[mux, minimum height=1.4cm] (muxB) at (4.2, 8.7)  {4:1\\MUX B};
\node[blk, minimum width=1.4cm, minimum height=1.8cm] (alu) at (6.4, 9.6) {ALU};
\node[preg] (exm1) at (8.1, 9.6)  {\textbf{\scriptsize EX/M1}\\RegWrite, Rd\\MemRead\\ALUResult};
\node[blk]  (m1)   at (9.7, 9.6)  {M1};
\node[preg] (m1m2) at (11.3, 9.6) {\textbf{\scriptsize M1/M2}\\RegWrite, Rd\\MemRead\\ALUResult};
\node[blk]  (m2)   at (12.9, 9.6) {M2};

% join register (shared by (a) and (b)) and RW
\node[draw, fill=gray!12, minimum width=0.5cm, minimum height=9.65cm] (join) at (14.5, 5.325) {};
\node[rotate=90, font=\scriptsize] at (join) {Join register (M2/RW, EX3/RW): RegWrite, Dest, FPWrite, Data};
\node[blk, minimum width=1.3cm, minimum height=1.1cm] (rw) at (16.3, 5.325) {RW};
\draw[arr] (join.east |- rw.west) -- (rw.west);

% datapath
\draw[arr] (idex.east) -- (2.2, 9.6);
\draw[arr] (alu.east) -- (exm1.west);
\draw[arr] (exm1.east) -- (m1.west);
\draw[arr] (m1.east) -- (m1m2.west);
\draw[arr] (m1m2.east) -- (m2.west);
\draw[arr] (m2.east) -- (14.25, 9.6);
\draw[arr] (4.9, 10.5) -- (5.3, 10.5) -- (5.3, 10.2) -- (5.7, 10.2);
\draw[arr] (4.9, 8.7)  -- (5.3, 8.7)  -- (5.3, 9.0)  -- (5.7, 9.0);

% mux input numbering
\foreach \y/\t in {11.025/00,10.675/01,10.325/10,9.975/11,9.225/00,8.875/01,8.525/10,8.175/11}
  \node[pin] at (3.42, \y) {\t};

% ID/EX operands into input 00
\draw (2.2, 9.225) -- (2.2, 11.025);
\draw[arr] (2.2, 11.025) -- (3.5, 11.025);
\draw[arr] (2.2, 9.225)  -- (3.5, 9.225);

% forwarding buses
\draw[arr] (exm1.north) -- (8.1, 11.7) -- (3.1, 11.7) -- (3.1, 8.875);
\draw[arr] (3.1, 10.675) -- (3.5, 10.675);
\draw[arr] (3.1, 8.875) -- (3.5, 8.875);
\draw[arr] (m1m2.north) -- (11.3, 12.1) -- (2.8, 12.1) -- (2.8, 8.525);
\draw[arr] (2.8, 10.325) -- (3.5, 10.325);
\draw[arr] (2.8, 8.525) -- (3.5, 8.525);
\draw[arr] (join.north) -- (14.5, 12.5) -- (2.5, 12.5) -- (2.5, 8.175);
\draw[arr] (2.5, 9.975) -- (3.5, 9.975);
\draw[arr] (2.5, 8.175) -- (3.5, 8.175);
\foreach \x/\y in {3.1/10.675,3.1/8.875,2.8/10.325,2.8/8.525,2.5/9.975,2.5/8.175}
  \fill (\x,\y) circle (1.2pt);

\node[lbl] at (5.6, 11.7) {EX/M1.ALUResult};
\node[lbl] at (7.0, 12.1) {M1/M2.ALUResult};
\node[lbl] at (9.0, 12.5) {RW.Data};

% integer forwarding unit
\node[fu] (ifu) at (7.5, 6.6) {Integer\\Forwarding Unit};

% inputs
\draw[ctrl] (idex.south) -- (1.2, 6.9) -- (6.0, 6.9);
\draw[ctrl] (exm1.south) -- (8.1, 7.1);
\draw[ctrl] (m1m2.south) -- (11.3, 6.8) -- (9.0, 6.8);
\draw[ctrl] (14.25, 6.4) -- (9.0, 6.4);
\node[lbl] at (3.0, 6.9) {Rs1, Rs2};
\node[lbl, right, align=center] at (8.15, 8.2) {RegWrite, Rd,\\MemRead};
\node[lbl, right, align=center] at (11.35, 8.2) {RegWrite, Rd,\\MemRead};
\node[lbl] at (12.2, 6.4) {RegWrite, Dest, FPWrite};

% outputs
\draw[ctrl] (6.0, 6.3) -- (0.2, 6.3) -- (0.2, 11.45) -- (4.2, 11.45) -- (muxA.north);
\draw[ctrl] (6.4, 7.1) -- (6.4, 7.55) -- (4.2, 7.55) -- (muxB.south);
\node[lbl] at (1.2, 11.45) {ForwardA[1:0]};
\node[lbl] at (2.5, 6.3) {ForwardA[1:0]};
\node[lbl] at (5.3, 7.55) {ForwardB[1:0]};

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% (b) FLOATING-POINT FORWARDING INTERFACE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\node[font=\bfseries] at (8.0, 4.95) {(b) Floating-point forwarding interface};

\node[preg] (idexfp) at (1.2, 3.2) {\textbf{\scriptsize ID/EX}\\Fs1, Fs2\\ReadData1\\ReadData2};
\node[mux, minimum height=0.9cm] (fmuxA) at (4.2, 3.7) {2:1\\MUX A};
\node[mux, minimum height=0.9cm] (fmuxB) at (4.2, 2.7) {2:1\\MUX B};
\node[blk, minimum width=1.4cm, minimum height=1.2cm] (ex1) at (6.4, 3.2) {EX-1};
\node[preg] (pr1) at (8.1, 3.2)  {\textbf{\scriptsize EX1/EX2}\\RegWrite, Fd\\Result};
\node[blk]  (ex2) at (9.7, 3.2)  {EX-2};
\node[preg] (pr2) at (11.3, 3.2) {\textbf{\scriptsize EX2/EX3}\\RegWrite, Fd\\Result};
\node[blk]  (ex3) at (12.9, 3.2) {EX-3};

\foreach \y/\t in {3.9/0,3.5/1,2.9/0,2.5/1}
  \node[pin] at (3.42, \y) {\t};

\draw[arr] (idexfp.east) -- (2.2, 3.2);
\draw (2.2, 2.9) -- (2.2, 3.9);
\draw[arr] (2.2, 3.9) -- (3.5, 3.9);
\draw[arr] (2.2, 2.9) -- (3.5, 2.9);
\draw[arr] (4.9, 3.7) -- (5.7, 3.7);
\draw[arr] (4.9, 2.7) -- (5.7, 2.7);
\draw[arr] (ex1.east) -- (pr1.west);
\draw[arr] (pr1.east) -- (ex2.west);
\draw[arr] (ex2.east) -- (pr2.west);
\draw[arr] (pr2.east) -- (ex3.west);
\draw[arr] (ex3.east) -- (14.25, 3.2);

% forwarding bus
\draw[arr] (14.25, 2.0) -- (2.7, 2.0) -- (2.7, 3.5);
\draw[arr] (2.7, 3.5) -- (3.5, 3.5);
\draw[arr] (2.7, 2.5) -- (3.5, 2.5);
\fill (2.7, 3.5) circle (1.2pt);
\fill (2.7, 2.5) circle (1.2pt);
\node[lbl] at (9.0, 2.0) {RW.Data};

% FP forwarding unit
\node[fu] (ffu) at (7.5, 0.7) {FP\\Forwarding Unit};

% inputs
\draw[ctrl] (idexfp.south) -- (1.2, 0.9) -- (6.0, 0.9);
\draw[ctrl] (pr1.south) -- (8.1, 1.2);
\draw[ctrl] (pr2.south) -- (11.3, 0.9) -- (9.0, 0.9);
\draw[ctrl] (14.25, 0.7) -- (9.0, 0.7);
\draw[ctrl] (13.5, 0.35) -- (9.0, 0.35);
\node[lbl] at (3.5, 0.9) {Fs1, Fs2};
\node[lbl, right] at (8.15, 1.65) {RegWrite, Fd};
\node[lbl, right] at (11.35, 1.65) {RegWrite, Fd};
\node[lbl] at (12.2, 0.7) {RegWrite, Dest, FPWrite};
\node[lbl] at (11.0, 0.35) {PendingA, PendingB};

% outputs
\draw[ctrl] (6.0, 0.5) -- (0.2, 0.5) -- (0.2, 4.5) -- (4.2, 4.5) -- (fmuxA.north);
\draw[ctrl] (6.4, 1.2) -- (6.4, 1.6) -- (4.2, 1.6) -- (fmuxB.south);
\node[lbl] at (1.2, 4.5) {FP\_ForwardA};
\node[lbl] at (3.0, 0.5) {FP\_ForwardA};
\node[lbl] at (5.3, 1.6) {FP\_ForwardB};

\end{tikzpicture}
